# 실제 키를 절대 넣지 않는 공유용 예시 파일입니다.
APP_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# AI 전략기획서 전용 모델입니다. 비워 두면 OPENAI_MODEL을 사용하고, 둘 다 비어 있으면 gpt-5.6을 사용합니다.
OPENAI_REPORT_MODEL=
# 근거 조사와 최종 품질 검토를 별도 모델로 운영할 때 지정합니다. 비우면 보고서 모델을 사용합니다.
OPENAI_RESEARCH_MODEL=
# 공식 성공사례 탐색과 지역 적합성 평가를 별도 모델로 운영할 때 지정합니다.
OPENAI_CASE_RESEARCH_MODEL=
OPENAI_TRANSFER_MODEL=
OPENAI_REVIEW_MODEL=
# 대시보드 AI 분석 도우미 전용 모델입니다. 비우면 보고서 모델을 사용합니다.
OPENAI_CHAT_MODEL=
# 학습용 ML 챗봇 모델입니다. 비우면 OPENAI_CHAT_MODEL → OPENAI_MODEL 순서로 사용합니다.
OPENAI_ML_CHAT_MODEL=
# OpenAI·React 관리자 학습 챗봇 모델입니다. 비우면 ML/공통 챗봇 모델을 순서대로 사용합니다.
OPENAI_LEARNING_CHAT_MODEL=
# Hybrid Multi-LLM: OpenAI는 공식 Web Search·최종 검수, Ollama는 로컬 구조화 추론에 사용합니다.
# 학생 비용 절약 기본값: Qwen/Gemma가 비교·기획·재검수를 맡고, OpenAI는 로컬 통과본의 독립 최종 검수 1회만 사용합니다.
# 지역별 최신 공식 웹 조사까지 자동으로 수행하려면 local_first를 선택합니다.
LLM_MODE=student_budget
LOCAL_LLM_BASE_URL=
# `ollama list`에 보이는 실제 tag를 입력합니다. 예: qwen3:14b, gemma4:26b
OLLAMA_QWEN_MODEL=
OLLAMA_GEMMA_MODEL=
# 26B 모델 첫 로드와 구조화 기획안 생성을 고려한 기본 제한(초). LAN 상태가 안정적이면 그대로 사용합니다.
LOCAL_LLM_TIMEOUT_SECONDS=1800
# 입력+출력 문맥 예산. local_first는 초과 시 유료 대체하지 않습니다. hybrid만 폴백 허용.
# 큰 문맥은 개인 노트북 메모리 사용량·응답 시간을 늘릴 수 있습니다.
# Qwen3:14b의 실제 context_length(40,960)를 기준으로 합니다. 더 크게 쓰려면
# 모든 로컬 모델의 지원 범위와 개인 노트북 GPU 메모리를 먼저 확인하세요.
LOCAL_LLM_CONTEXT_LENGTH=40960
# 관리자 라우팅 저장 권한입니다. 실제 값은 팀 내부 .env에만 입력하고 React에 넣지 않습니다.
LLM_ADMIN_TOKEN=
# 공식 조직 비용 API를 연결할 경우에만 별도 관리자 키를 사용합니다. 일반 OpenAI 키와 다를 수 있습니다.
OPENAI_ADMIN_KEY=
# 최초 권장 Routing입니다. 이후 관리자 화면 변경은 storage/llm_runtime_config.json에 저장됩니다.
LLM_EVIDENCE_PROVIDER=openai
LLM_CASE_STUDY_PROVIDER=openai
LLM_TRANSFER_PROVIDER=ollama
LLM_TRANSFER_MODEL=qwen
LLM_PLANNER_PROVIDER=ollama
LLM_PLANNER_MODEL=gemma
LLM_REVIEWER_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_AGENT_TIMEOUT_SECONDS=300
ENABLE_OFFICIAL_WEB_RESEARCH=true
ENABLE_CASE_STUDY_WEB_RESEARCH=true
# 학생 절약 모드 전용: Qwen이 짧은 조사 질문을 만들면 서버가 아래 무료 API로
# 허용된 공식 도메인의 제목·URL·요약만 조회합니다. 원문 크롤링·자동 RAG 저장은 하지 않습니다.
# Tavily는 무료 월간 할당량의 기본 공급자, Brave는 앞선 검색 실패 시에만 선택 보조로 호출됩니다.
# 실제 키는 루트 .env에만 입력하고, 키가 비어 있으면 저장된 공식 문서·Open API만 사용합니다.
ENABLE_LOCAL_OFFICIAL_WEB_SEARCH=true
LOCAL_WEB_SEARCH_PROVIDERS=tavily
LOCAL_WEB_SEARCH_MAX_QUERIES_PER_REPORT=2
LOCAL_WEB_SEARCH_MAX_RESULTS_PER_QUERY=4
LOCAL_WEB_SEARCH_TIMEOUT_SECONDS=18
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Naver 검색 API는 결과 독립 노출 약관이 있어 LLM 입력 도구로 사용하지 않습니다.
# 추후 사용자에게 검색 결과를 그대로 보여 주는 UI 기능을 별도 검토합니다.
# 동일 원자료로 다시 보고서를 만들 때 공식 자료조사를 재사용하는 시간(초). 0이면 캐시를 끕니다.
EVIDENCE_CACHE_TTL_SECONDS=3600
# 전국 성공사례는 지역 원자료보다 덜 자주 바뀌므로 기본 6시간 캐시합니다.
CASE_STUDY_CACHE_TTL_SECONDS=21600
CHROMA_PERSIST_DIRECTORY=data/chroma
# 쉼표로 구분한 공식 도메인만 조사·RAG 출처로 허용합니다. 시범지역 공식 도메인을 추가하세요.
TOURISM_ALLOWED_RESEARCH_DOMAINS=visitkorea.or.kr,kto.visitkorea.or.kr,data.go.kr,mcst.go.kr,seoul.go.kr,gangnam.go.kr,incheon.go.kr,jeonnam.go.kr,evaluation.go.kr,jeonju.go.kr
TOUR_API_SERVICE_KEY=
TOUR_CONTENT_LAB_API_KEY=
TOUR_INFO_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
VISITKOREA_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# 로컬 PC 또는 AWS RDS의 MySQL 연결 정보입니다. 실제 비밀번호는 .env에만 입력합니다.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tourism_strategy
MYSQL_USER=tourism_app
MYSQL_PASSWORD=

# VWorld 행정구역 경계: 실제 값은 루트 .env에만 입력합니다.
VWORLD_API_KEY=
VWORLD_WFS_BASE_URL=https://api.vworld.kr/req/wfs
VWORLD_WMS_BASE_URL=https://api.vworld.kr/req/wms
VWORLD_ALLOWED_DOMAIN=localhost
